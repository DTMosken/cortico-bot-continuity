{
  "name": "cortico-bot-continuity",
  "version": "0.5.1",
  "type": "module",
  "description": "Cortico 的 Bot 扩展，为机器人带来持续的记忆和鲜明的个性，记住经历，整理往事，延续对话。",
  "license": "MIT",
  "author": "DTMosken",
  "keywords": [
    "cortico-bot",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./index.ts",
  "cortico": {
    "kind": "bot",
    "api": 7,
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "tags": [
      "memory",
      "companion"
    ],
    "describe": "describe.json"
  },
  "files": [
    "index.ts",
    "base",
    "persona",
    "python",
    "scripts",
    "webui",
    "webui-page.ts",
    "dist",
    "README.md",
    "describe.json",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "build:webui": "esbuild webui/client.ts --bundle --format=esm --outfile=dist/webui.js --loader:.css=css",
    "laya:multilingual:setup": "node scripts/laya-multilingual-setup.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "re2js": "2.8.6"
  },
  "optionalDependencies": {
    "@receptron/laya": "0.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DTMosken/cortico-bot-continuity.git"
  }
}
